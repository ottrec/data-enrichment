== Brewer Pool and Arena schedule_changes "Drop-in schedule - swim and aquafitness"
- IGNORED date-context "Saturday, October 10 to Monday, October 12"
    at: group "Drop-in schedule - swim and aquafitness"
- NOTICE "See Thanksgiving weekend schedule."
    date text: "Saturday, October 10 to Monday, October 12"
    dates: 2026-10-10 Sat to 2026-10-12 Mon
    effects: see-schedule "Thanksgiving weekend schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swim and aquafitness"

== Brewer Pool and Arena schedule_changes "Drop-in schedule - skating"
- IGNORED date-context "Saturday, December 26"
    at: group "Drop-in schedule - skating"
- NOTICE "All drop-in skating, cancelled"
    date text: "Saturday, December 26"
    dates: 2026-12-26 Sat
    time: "" covers [Saturday 7:00 - 7:50pm; Saturday 8:00 - 8:50pm]
    effects: cancelled
    match: SCOPE_PHRASE
    phrase: "All drop-in skating"
    sources: schedule_changes special_hours
    at: group "Drop-in schedule - skating"

== Brewer Pool and Arena special_hours
- IGNORED date-context "Saturday, December 26"
    at: facility
- IGNORED duplicate "All drop-in skating, cancelled"
    date text: "Saturday, December 26"
    dates: 2026-12-26 Sat
    time: "" covers [Saturday 7:00 - 7:50pm; Saturday 8:00 - 8:50pm]
    match: SCOPE_PHRASE
    phrase: "All drop-in skating"
    duplicate of: schedule_changes "Drop-in schedule - skating" "All drop-in skating, cancelled"
    at: facility
