== Deborah Anne Kirwan Pool schedule_changes "Drop-in schedule - swim and aquafit"
- IGNORED date-context "Monday, December 22 to Friday, January 4"
    at: group "Drop-in schedule - swim and aquafit"
- NOTICE "See Winter Break schedule."
    date text: "Monday, December 22 to Friday, January 4"
    dates: 2025-12-22 Mon to 2026-01-04 Sun
    effects: see-schedule "Winter Break schedule" "https://ottawa.ca/en/deborah-anne-kirwan-pool-holiday-drop-schedule"
    match: SCOPE_PHRASE
    ambiguities: weekday-mismatch
    at: group "Drop-in schedule - swim and aquafit"

