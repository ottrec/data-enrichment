== Splash Wave Pool schedule_changes "Drop-in schedule - swim and aquafitness"
- IGNORED date-context "Tuesday, May 5"
    at: group "Drop-in schedule - swim and aquafitness"
- NOTICE "Public Swim - wave tank and warm pool, 4:30 to 9:15 pm, cancelled"
    date text: "Tuesday, May 5"
    dates: 2026-05-05 Tue
    time: "4:30 to 9:15 pm" 16:30-21:15 covers [Tuesday 4:30 - 9:00pm]
    effects: cancelled
    match: EXACT
    phrase: "Public Swim - wave tank and warm pool"
    ambiguities: meridiem-inferred
    sources: schedule_changes special_hours
    at: group "Drop-in schedule - swim and aquafitness" activity "Public Swim - wave tank and warm pool" sessions 2026-05-05 Tue 16:30-21:00
- IGNORED date-context "Saturday, May 16 to Monday, May 18"
    at: group "Drop-in schedule - swim and aquafitness"
- NOTICE "See Victoria Day weekend schedule."
    date text: "Saturday, May 16 to Monday, May 18"
    dates: 2026-05-16 Sat to 2026-05-18 Mon
    effects: see-schedule "Victoria Day weekend schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swim and aquafitness"

