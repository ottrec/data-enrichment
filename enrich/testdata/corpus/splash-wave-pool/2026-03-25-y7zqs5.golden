== Splash Wave Pool schedule_changes "Drop-in schedule - swim and aquafitness"
- IGNORED date-context "Friday, April 3 to Monday, April 6"
    at: group "Drop-in schedule - swim and aquafitness"
- NOTICE "The facility is closed and all programs cancelled."
    date text: "Friday, April 3 to Monday, April 6"
    dates: 2026-04-03 Fri to 2026-04-06 Mon
    effects: cancelled, closure
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swim and aquafitness"

== Splash Wave Pool special_hours
- NOTICE "Lap pool heater broken. Pool temperature is colder than normal until further notice"
    dates: open-ended
    match: NONE
    phrase: "Lap pool heater broken"
    amenity: "lap pool"
    at: facility
- NOTICE "Lap pool heater broken. Pool temperature is colder than normal until further notice"
    dates: open-ended
    match: NONE
    phrase: "Pool temperature is colder than normal until further notice"
    amenity: "pool"
    at: facility
- IGNORED heading "Easter weekend hours"
    section: "Easter weekend hours"
    at: facility
- NOTICE "Friday, April 3 to Monday, April 6, closed"
    section: "Easter weekend hours"
    date text: "Friday, April 3 to Monday, April 6"
