== Katimavik Pool schedule_changes "Drop-in schedule - swim"
- IGNORED date-context "Monday, August 3"
    at: group "Drop-in schedule - swim"
- NOTICE "See Civic Holiday schedule."
    date text: "Monday, August 3"
    dates: 2026-08-03 Mon
    effects: see-schedule "Civic Holiday schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swim"

== Katimavik Pool special_hours
- NOTICE "Regular season, June 29 to August 23"
    date text: "June 29 to August 23"
    dates: 2026-06-29 Mon to 2026-08-23 Sun
    effects: seasonal-hours
    match: SCOPE_PHRASE
    phrase: "Regular season"
    at: facility
- IGNORED heading "Civic Holiday"
    section: "Civic Holiday"
    at: facility
- NOTICE "Monday, August 3, noon to 5 pm"
    section: "Civic Holiday"
    date text: "Monday, August 3"
    dates: 2026-08-03 Mon
    time: "noon to 5 pm" 12:00-17:00 unchecked
    effects: modified-hours
    at: facility
