== Entrance Pool schedule_changes "Drop-in schedule - swimming"
- IGNORED date-context "Wednesday, July 1"
    at: group "Drop-in schedule - swimming"
- NOTICE "See Canada Day schedule."
    date text: "Wednesday, July 1"
    dates: 2026-07-01 Wed
    effects: see-schedule "Canada Day schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swimming"

== Entrance Pool special_hours
- NOTICE "Wednesday, July 1, 11 am to 4 pm"
    date text: "Wednesday, July 1"
    dates: 2026-07-01 Wed
    time: "11 am to 4 pm" 11:00-16:00 unchecked
    effects: modified-hours
    at: facility
- IGNORED heading "Summer 2026"
    section: "Summer 2026"
    at: facility
- NOTICE "Pre-season, June 13 to 28"
    section: "Summer 2026"
    date text: "June 13 to 28"
    dates: 2026-06-13 Sat to 2026-06-28 Sun
    effects: seasonal-hours
    match: SCOPE_PHRASE
    phrase: "Pre-season"
    at: facility
- NOTICE "Regular season, June 29 to August 16"
    section: "Summer 2026"
    date text: "June 29 to August 16"
    dates: 2026-06-29 Mon to 2026-08-16 Sun
    effects: seasonal-hours
    match: SCOPE_PHRASE
    phrase: "Regular season"
    at: facility
