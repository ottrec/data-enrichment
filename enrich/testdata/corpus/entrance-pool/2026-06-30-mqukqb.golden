== Entrance Pool schedule_changes "Drop-in schedule - swimming"
- IGNORED date-context "Wednesday, July 1"
    at: group "Drop-in schedule - swimming"
- NOTICE "See Canada Day schedule."
    date text: "Wednesday, July 1"
    dates: 2026-07-01 Wed
    effects: see-schedule "Canada Day schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swimming"
- IGNORED date-context "Thursday, July 13"
    at: group "Drop-in schedule - swimming"
- NOTICE "Public swim will end at 6 pm."
    date text: "Thursday, July 13"
    dates: 2026-07-13 Mon
    time: "will end at 6 pm." 18:00-24:00 open-end overlaps [Monday 1:00 - 7:00pm]
    effects: time-change
    match: EXACT
    phrase: "Public swim"
    ambiguities: weekday-mismatch
    at: group "Drop-in schedule - swimming" activity "Public swim" sessions 2026-07-13 Mon 13:00-19:00

