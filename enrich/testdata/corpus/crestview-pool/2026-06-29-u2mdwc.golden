== Crestview Pool schedule_changes "Drop-in schedule - swim and aquafitness"
- IGNORED date-context "Wednesday, July 1"
    at: group "Drop-in schedule - swim and aquafitness"
- NOTICE "See Canada Day schedule."
    date text: "Wednesday, July 1"
    dates: 2026-07-01 Wed
    effects: see-schedule "Canada Day schedule"
    match: SCOPE_PHRASE
    at: group "Drop-in schedule - swim and aquafitness"

== Crestview Pool special_hours
- NOTICE "Regular season, June 26 to August 31"
    date text: "June 26 to August 31"
    dates: 2026-06-26 Fri to 2026-08-31 Mon
    effects: seasonal-hours
    match: SCOPE_PHRASE
    phrase: "Regular season"
    at: facility
- IGNORED heading "Modified hours"
    section: "Modified hours"
    at: facility
- NOTICE "Wednesday, July 1, 11 am to 4:30 pm"
    section: "Modified hours"
    date text: "Wednesday, July 1"
    dates: 2026-07-01 Wed
    time: "11 am to 4:30 pm" 11:00-16:30 unchecked
    effects: modified-hours
    at: facility
